{
  "languageserver": {
    "java": {
        "java.removeUnusedImportsOnSave": true,
      "eclipse.jdt.ls.java.saveActions.organizeImports": true,
      "eclipse.jdt.ls.java.completion.enabled": true,
      "eclipse.jdt.ls.java.completion.guessMethodArguments": true,
      "eclipse.jdt.ls.java.completion.favoriteStaticMembers": [
        "org.junit.Assert.*",
        "org.junit.Assume.*",
        "org.junit.jupiter.api.Assertions.*",
        "org.junit.jupiter.api.Assumptions.*",
        "org.junit.jupiter.api.DynamicContainer.*",
        "org.junit.jupiter.api.DynamicTest.*",
        "org.mockito.Mockito.*",
        "org.hamcrest.MatcherAssert.assertThat",
        "org.hamcrest.Matchers.*",
        "org.hamcrest.CoreMatchers.*"
      ]
    }
  }
}

